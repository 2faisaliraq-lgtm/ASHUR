{
  "name": "functions",
  "description": "Cloud Functions for Firebase - Ashur System",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "notify:subscription-expiry": "node subscription_expiry_notifier.js",
    "test:notifications": "node test-notification-normalization.js",
    "test:subscription-expiry": "node --test test-subscription-expiry-notifier.js",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
