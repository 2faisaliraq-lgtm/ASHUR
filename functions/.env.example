# External scheduled subscription notifier. Set actual values in the hosting provider.
# Never commit a real OneSignal key or Firebase service-account JSON.
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\path\\service-account.json
# Firebase Functions (only if you separately deploy Firebase Functions):
# firebase functions:secrets:set ONESIGNAL_REST_API_KEY
# Existing local-only examples
FIREBASE_PROJECT_ID=ashur-official
FIREBASE_STORAGE_BUCKET=ashur-official.firebasestorage.app
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SMTP_USER=your-email@gmail.com
